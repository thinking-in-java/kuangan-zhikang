    <resultMap id="BaseResultMapdetail" type="com.yihe.system.domain.YhTemplateDetail" >
        <id column="details_id" property="detailsId" jdbcType="INTEGER" />
        <result column="execute_date" property="executeDate" jdbcType="TIMESTAMP" />
        <result column="service_way" property="serviceWay" jdbcType="INTEGER" />
        <result column="plan_count" property="planCount" jdbcType="VARCHAR" />
        <result column="count_prompt" property="countPrompt" jdbcType="VARCHAR" />
        <result column="user_code" property="userCode" jdbcType="VARCHAR" />
        <result column="returnway" property="servicenam" jdbcType="VARCHAR" />

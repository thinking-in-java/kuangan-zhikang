    <select id="get" parameterType="com.yihe.system.domain.PeriodComparison" resultMap="BaseResultMap">
        SELECT * from (select * from (
        select yd.*  from yh_disease_assess_total_report2 yd join yh_user_reginfo yu on yd.user_code = yu.user_code
        <where>
            <if test="model.startTime != '' and  model.startTime != null">
                and yd.qtime >= DATE_FORMAT(#{model.startTime},"%Y-%m-%d %H:%i:%s")
            </if>
            <if test="model.endTime != '' and  model.endTime != null">
                and yd.qtime &lt;= DATE_FORMAT(#{model.endTime},"%Y-%m-%d %H:%i:%s")
            </if>
            <if test="model.orgCode != '' and  model.orgCode != null">
                and yu.org_code  like concat('%', #{model.orgCode}, '%')
            </if>
            <if test="model.ageStart != '' and  model.ageStart != null">
                and yu.birth_date   &lt;= #{model.begorberthday}
            </if>
            <if test="model.ageEnd != '' and  model.ageEnd != null">
                and yu.birth_date >=  #{model.endberthday}
            </if>
            <if test="model.sex != '' and  model.sex != null">
                and yu.gender = #{model.sex}
            </if>

        </where>  order by qtime) as datas group by user_code ) as tab LEFT JOIN yh_question_check_json2  json2
        ON tab.request_serialNum=json2.request_serialNum
    </select>

    <select id="getMeddle" parameterType="com.yihe.system.domain.PeriodComparison" resultMap="BaseResultMap">
        SELECT * from (select * from (
        select yd.*  from yh_disease_assess_total_report2 yd join yh_user_reginfo yu on yd.user_code = yu.user_code
        <where>
            <if test="model.startTime != '' and  model.startTime != null">
                and yd.qtime >= DATE_FORMAT(#{model.startTime},"%Y-%m-%d %H:%i:%s")
            </if>
            <if test="model.endTime != '' and  model.endTime != null">
                and yd.qtime &lt;= DATE_FORMAT(#{model.endTime},"%Y-%m-%d %H:%i:%s")
            </if>
            <if test="model.orgCode != '' and  model.orgCode != null">
                and yu.org_code  like concat('%', #{model.orgCode}, '%')
            </if>
            <if test="model.ageStart != '' and  model.ageStart != null">
                and yu.birth_date &lt;=  #{model.begorberthday}
            </if>
            <if test="model.ageEnd != '' and  model.ageEnd != null">
                and yu.birth_date >=  #{model.endberthday}
            </if>
            <if test="model.sex != '' and  model.sex != null">
                and yu.gender = #{model.sex}
            </if>

        </where>  order by qtime desc) as datas group by user_code) as tab LEFT JOIN yh_question_check_json2  json2
        ON tab.request_serialNum=json2.request_serialNum
    </select>

    <select id="selectbmi" parameterType="String" resultType="String">

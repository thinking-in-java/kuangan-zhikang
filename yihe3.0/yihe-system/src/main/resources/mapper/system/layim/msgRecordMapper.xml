<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yihe.system.mapper.layim.MsgRecordMapper">
    <parameterMap id="msgRecordMap" type="com.yihe.system.domain.layim.MsgRecord">
        <parameter property="from" />
        <parameter  property="to" />
        <parameter  property="room" />
        <parameter  property="createAt" />
        <parameter  property="msgType" />
    </parameterMap>
    <resultMap id="msgRecordResultMap" type="com.yihe.system.domain.layim.MsgRecord">
        <result column="from_id" property="from" />
        <result column="room_id" property="room" />
        <result column="create_at" property="createAt" />
    </resultMap>
   <insert id="addRecord" parameterMap="msgRecordMap">
       INSERT INTO layim_msg_record (id,from_id,to_id,room_id,contents,create_at,mtype) values (#{id},#{from},#{to},#{room},#{contents},#{createAt},#{msgType})
   </insert>

    <select id="getList" resultMap="msgRecordResultMap">
        SELECT id,from_id,contents,create_at FROM layim_msg_record
        <where>
            <if test="arg0 != null ">room_id=#{arg0}</if>
            <if test="arg1 != null and arg1!=0" >and id &lt; #{arg1}</if>
        </where>
        order by Id desc limit 20
    </select>
</mapper>
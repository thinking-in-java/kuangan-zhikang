<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yihe.system.mapper.layim.BigGroupMapper">
    <resultMap id="bigGroupMap" type="com.yihe.system.domain.layim.BigGroup">
        <result column="group_name" property="groupname" />
    </resultMap>

    <select id="getGroupOwnerId" parameterType="String" resultType="java.lang.Long">
        SELECT uid FROM layim_big_group  WHERE id=#{id}
    </select>
    <select id="getGroupsByGroupIds" parameterType="String" resultMap="bigGroupMap">
        SELECT id,avatar,group_name FROM layim_big_group WHERE  id in
        <foreach collection="list" item="id" index="index" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>
    <select id="getGroupMembers" parameterType="String" resultType="java.lang.Long">
        SELECT uid FROM layim_user_big_group WHERE group_id=#{id}
    </select>
    <select id="getGroupsByUserId" parameterType="String" resultType="java.lang.Long">
        SELECT group_id FROM layim_user_big_group WHERE uid=#{id}
    </select>
    
    <select id="getGroupsByDoctor" parameterType="String" resultMap="bigGroupMap">
        SELECT 
   U_Docgroup_Id  AS id,Gname AS group_name
    FROM yh_doc_group
    WHERE Docid = (SELECT id FROM  yh_user_admin_info WHERE  user_code=#{usercode}) OR  Sort=1  ORDER BY  establishTime DESC
    
    </select>
    
    

</mapper>
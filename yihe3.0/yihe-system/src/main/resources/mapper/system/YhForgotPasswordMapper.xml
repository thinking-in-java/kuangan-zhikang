<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhForgotPasswordMapper">
	 <resultMap id="InItYhJzSysSms" type="com.yihe.system.domain.YhJzSysSms">
	 	  <id column="sms_id" jdbcType="BIGINT" property="smsId" />
	 	  <result column="template_id" jdbcType="VARCHAR" property="templateId" />
	 	  <result column="smsname" jdbcType="VARCHAR" property="smsname" />
	 	  <result column="signname" jdbcType="VARCHAR" property="signname" />
	 	  <result column="accessKey" jdbcType="VARCHAR" property="accesskey" />
	 	  <result column="accessKeySecret" jdbcType="VARCHAR" property="accesskeysecret" />
	 	  <result column="smscode_num" jdbcType="INTEGER" property="smscodeNum" />
	 	  <result column="sms_create" jdbcType="TIMESTAMP" property="smsCreate" />
	 	  <result column="sms_modified" jdbcType="TIMESTAMP" property="smsModified" />
	 	   <result column="type" jdbcType="INTEGER" property="type" />
	 </resultMap>
	<select id="selectcount" resultType="java.lang.Integer">
		select count(user_code) from yh_user_reginfo
		<where>
			<if test="name!=null and name!=''">
				user_name=#{name}
			</if>
			<if test="phone!=null and phone!=''">
			 and	mobile=#{phone}
			</if>
		</where>
	</select>
	<update id="updatepwd" parameterType="com.yihe.system.domain.YhUserReginfo" >
		UPDATE yh_user_reginfo set user_pwd=#{userPwd}
			WHERE user_name=#{userName}
	</update>
	<select id="sms" resultMap="InItYhJzSysSms">
		select * from yh_jz_sys_sms limit 1
	</select>
</mapper>
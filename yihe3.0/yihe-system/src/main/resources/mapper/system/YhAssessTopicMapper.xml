<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhAssessTopicMapper">
    <resultMap id="BaseResultMap" type="YhAssessTopic">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="assess" property="assess" jdbcType="VARCHAR"/>
        <result column="sort" property="sort" jdbcType="INTEGER"/>
        <collection property="options" ofType="yhAssessOption">
            <id column="optid" property="id" jdbcType="INTEGER"/>
            <result column="topic_id" property="topicId" jdbcType="INTEGER"/>
            <result column="option" property="option" jdbcType="VARCHAR"/>
            <result column="score" property="score" jdbcType="INTEGER"/>
        </collection>
    </resultMap>

    <select id="findByAssess" parameterType="string" resultMap="BaseResultMap">
        select ato.id, `name`, assess, sort, aop.id as optid, topic_id, `option`, score
        from yh_assess_topic ato
        left join yh_assess_option aop on aop.topic_id = ato.id
        where assess = #{assess} order by sort,aop.id
    </select>
</mapper>
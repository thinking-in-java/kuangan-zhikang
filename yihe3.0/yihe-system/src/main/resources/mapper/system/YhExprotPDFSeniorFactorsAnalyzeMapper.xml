	  <select id="selectdiseaseriskresult" parameterType="com.yihe.system.domain.YhExportPDFData" resultMap="exprotresult2">
		  SELECT repo.id,repo.request_serialNum,repo.user_code,repo.gender,repo.age as ages,drr.id AS did,drr.*,regi.`name`
		  FROM( SELECT * FROM (SELECT  * from yh_disease_assess_total_report2  order by qtime desc ) a GROUP BY user_code) repo
			  LEFT JOIN yh_disease_risk_result2  drr
		  ON repo.request_serialNum=drr.request_serialize
		  LEFT JOIN yh_user_reginfo regi
		  ON regi.user_code=repo.user_code
		  LEFT JOIN yh_org_tree orgtree
		  on regi.Org_Code=orgtree.Org_Code
		<where>
			orgtree.Org_Code like CONCAT('%',#{nowselect},'%')
			 <if test="begintime!=null">
			 	and repo.qtime between #{begintime} and #{endtime}
			 </if>		
  		</where>
  </select>

	<select id="selectallcount" parameterType="com.yihe.system.domain.YhExportPDFData" resultMap="exprotresult2">
		SELECT repo.id,repo.request_serialNum,repo.user_code,repo.gender,repo.age as ages,drr.id AS did,drr.*,regi.`name`
		FROM( SELECT * FROM (SELECT  * from yh_disease_assess_total_report2  order by qtime desc ) a GROUP BY user_code) repo
		LEFT JOIN yh_disease_risk_result2  drr
		ON repo.request_serialNum=drr.request_serialize
		LEFT JOIN yh_user_reginfo regi
		ON regi.user_code=repo.user_code
		LEFT JOIN yh_org_tree orgtree
		on regi.Org_Code=orgtree.Org_Code
		<where>
			orgtree.Org_Code like CONCAT('%',#{nowselect},'%')
			<if test="begintime!=null">
				and year(repo.qtime)=#{begintime} and month(repo.qtime)=#{endtime}
			</if>
		</where>

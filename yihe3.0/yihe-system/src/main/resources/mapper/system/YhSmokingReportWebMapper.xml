<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhSmokingReportWebMapper">
    
    <resultMap type="YhSmokingReportWeb" id="YhSmokingReportResult">
        <result property="smokingReportId"    column="smoking_report_id"    />
        <result property="userCode"    column="user_code"    />
        <result property="smokingReportDesc"    column="smoking_report_desc"    />
        <result property="smokingReportScore"    column="smoking_report_score"    />
        <result property="smokingReportLevel"    column="smoking_report_level"    />
        <result property="smokingReportQueselect"    column="smoking_report_queselect"    />
        <result property="usercode"    column="user_code"    />
        <result property="name"    column="name"    />
        <result property="mobile"    column="mobile"    />
        <result property="num"    column="num"    />
    </resultMap>

    <sql id="selectYhSmokingReportVo">
        select smoking_report_id, user_code, smoking_report_desc, smoking_report_score, smoking_report_level, smoking_report_queselect, qtime from yh_smoking_report
    </sql>
    <sql id="selectYhSmokingReportZiDuan">
         smoking_report_id, user_code, smoking_report_desc, smoking_report_score, smoking_report_level, smoking_report_queselect, qtime
    </sql>

    <select id="selectYhSmokingReportListByWeb" parameterType="YhSmokingReportWeb" resultMap="YhSmokingReportResult">
        SELECT tab.* from (
           SELECT
            ur.user_code,
            ur.`name`,
            ur.mobile,
            COUNT(sr.user_code) as num,
            sr.smoking_report_level,
            sr.smoking_report_score,
            sr.qtime,
            sr.smoking_report_id
        FROM
            yh_user_reginfo AS ur
        LEFT JOIN (
            SELECT
                <include refid="selectYhSmokingReportZiDuan"/>
            FROM
                yh_smoking_report
            ORDER BY
                qtime DESC
        ) sr ON sr.user_code = ur.user_code
        LEFT JOIN `yh_user_make_card` AS umc ON umc.user_code = ur.user_code
        <where>
            AND  umc.doctor = #{doctor}
            <if test="strTime!=null and strTime!='' and endTime!=null and endTime!=''">
                AND sr.qtime BETWEEN #{strTime}
                AND #{endTime}
            </if>
            <if test="''!=orgId and null != orgId">
                and  umc.org_id=#{orgId}
            </if>
            <if test="''!=name and null != name">
                and  (ur.user_code like concat('%',#{name},'%') or ur.`name` like concat('%',#{name},'%') or ur.mobile like concat('%',#{name},'%'))
            </if>


        </where>

        GROUP BY
            ur.user_code
        having 1=1
        <if test="smokingReportLevel!=null and smokingReportLevel!=''">
            and   sr.smoking_report_level=#{smokingReportLevel}
        </if>
          ORDER BY  COUNT(sr.user_code) desc
        ) as tab order by tab.qtime desc

    </select>

    <select id="selectYhSmokingReportList" parameterType="YhSmokingReportWeb" resultMap="YhSmokingReportResult">
        <include refid="selectYhSmokingReportVo"/>
        <where>  
            <if test="userCode != null  and userCode != ''"> and user_code = #{userCode}</if>
            <if test="smokingReportDesc != null  and smokingReportDesc != ''"> and smoking_report_desc = #{smokingReportDesc}</if>
            <if test="smokingReportScore != null "> and smoking_report_score = #{smokingReportScore}</if>
            <if test="smokingReportLevel != null  and smokingReportLevel != ''"> and smoking_report_level = #{smokingReportLevel}</if>
            <if test="smokingReportQueselect != null  and smokingReportQueselect != ''"> and smoking_report_queselect = #{smokingReportQueselect}</if>
            <if test="qtime != null "> and qtime = #{qtime}</if>
        </where>
    </select>
    
    <select id="selectYhSmokingReportById" parameterType="Long" resultMap="YhSmokingReportResult">
        <include refid="selectYhSmokingReportVo"/>
        where smoking_report_id = #{smokingReportId}
    </select>
        
    <insert id="insertYhSmokingReport" parameterType="YhSmokingReportWeb" useGeneratedKeys="true" keyProperty="smokingReportId">
        insert into yh_smoking_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userCode != null">user_code,</if>
            <if test="smokingReportDesc != null">smoking_report_desc,</if>
            <if test="smokingReportScore != null">smoking_report_score,</if>
            <if test="smokingReportLevel != null">smoking_report_level,</if>
            <if test="smokingReportQueselect != null">smoking_report_queselect,</if>
            <if test="qtime != null">qtime,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userCode != null">#{userCode},</if>
            <if test="smokingReportDesc != null">#{smokingReportDesc},</if>
            <if test="smokingReportScore != null">#{smokingReportScore},</if>
            <if test="smokingReportLevel != null">#{smokingReportLevel},</if>
            <if test="smokingReportQueselect != null">#{smokingReportQueselect},</if>
            <if test="qtime != null">#{qtime},</if>
         </trim>
    </insert>

    <update id="updateYhSmokingReport" parameterType="YhSmokingReportWeb">
        update yh_smoking_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="userCode != null">user_code = #{userCode},</if>
            <if test="smokingReportDesc != null">smoking_report_desc = #{smokingReportDesc},</if>
            <if test="smokingReportScore != null">smoking_report_score = #{smokingReportScore},</if>
            <if test="smokingReportLevel != null">smoking_report_level = #{smokingReportLevel},</if>
            <if test="smokingReportQueselect != null">smoking_report_queselect = #{smokingReportQueselect},</if>
            <if test="qtime != null">qtime = #{qtime},</if>
        </trim>
        where smoking_report_id = #{smokingReportId}
    </update>

    <delete id="deleteYhSmokingReportById" parameterType="Long">
        delete from yh_smoking_report where smoking_report_id = #{smokingReportId}
    </delete>

    <delete id="deleteYhSmokingReportByIds" parameterType="String">
        delete from yh_smoking_report where smoking_report_id in 
        <foreach item="smokingReportId" collection="array" open="(" separator="," close=")">
            #{smokingReportId}
        </foreach>
    </delete>

</mapper>
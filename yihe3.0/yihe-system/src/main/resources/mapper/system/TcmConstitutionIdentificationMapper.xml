    </resultMap>


    <!-- 查询所有用户的中医体质辨识信息 -->
    <select id="tcmConstitutionIdentificationUserAll" resultMap="YhUserReginfo" parameterType="map">
        select r.user_code,r.name as name,r.mobile as mobile,(select count(*) from yh_chinese_anwser where User_code = r.user_code group by User_code) as times,
        (select max(time) from yh_chinese_anwser where User_code = r.user_code group by User_code) as time,a.A_istype,a.B_istype,a.C_istype,a.D_istype,
        a.E_istype,a.F_istype,a.G_istype,a.H_istype,a.I_istype,ma.org_id
        from yh_user_reginfo r
        left join (select * from `yh_chinese_anwser` order by time desc) as a on a.User_code = r.user_code
        LEFT JOIN `yh_user_make_card` AS ma
		 ON ma.user_code=r.user_code
        where r.User_Type = 5
        and ma.doctor = #{doctor}
        group by r.user_code
        having
        1=1
        <if test="''!=tree and null != tree">
          and  org_id=#{tree}
        </if>
        <if test="''!=name and null != name">
            and  user_code like concat('%',#{name},'%') or name like concat('%',#{name},'%') or mobile like concat('%',#{name},'%')
        </if>
        <if test="strTime!=null and strTime!='' and endTime!=null and endTime!=''">
            AND `time` BETWEEN #{strTime}
            AND #{endTime}
        </if>
        <if test="''!=key and null != key and ''!=value and null != value">
            and ${key}=#{value}
        </if>


        order by times desc
    </select>

    <!-- 根据筛选条件查询用户信息 -->
    <select id="tcmConstitutionIdentificationConditionUser" resultMap="YhUserReginfo">
        select r.user_code,r.name,r.mobile,(select count(*) from yh_chinese_anwser where User_code = r.user_code group by User_code) as num,a.A_istype,
        (select max(time) from yh_chinese_anwser where User_code = r.user_code group by User_code) as time,a.A_istype,a.B_istype,a.C_istype,a.D_istype,
        a.E_istype,a.F_istype,a.G_istype,a.H_istype,a.I_istype from yh_user_reginfo r
        left join (select * from `yh_chinese_anwser` order by time desc) as a on a.User_code = r.user_code
        <where>
            <if test="tree!=null">
                and r.Org_Code = #{tree}
            </if>
            <if test="pinggu!=null">

            </if>
            <if test="name!=null">
                and (r.user_code like concat('%',#{name},'%') or r.mobile like concat('%',#{name},'%')
                or r.name like concat ('%',#{name},'%') or r.user_name like concat('%',#{name},'%'))
            </if>
            <if test="startTime!=null">
                and a.time = #{startTime}
            </if>
        </where>
        group by r.user_code
    </select>

    <!-- 根据筛选条件查询用户信息 -->
    <select id="selectDoctorIdByUserCode" resultType="String">
        select id from yh_user_admin_info where user_code = #{userCode}
    </select>


<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhAssessIntroduceMapper">
    <resultMap id="BaseResultMap" type="com.yihe.system.domain.YhAssessIntroduce">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="reference" property="reference" jdbcType="VARCHAR"/>
        <result column="introduce" property="introduce" jdbcType="VARCHAR"/>
        <result column="question_count" property="questionCount" jdbcType="INTEGER"/>
        <result column="required_time" property="requiredTime" jdbcType="INTEGER"/>
    </resultMap>

    <select id="getByIntroduceName" resultMap="BaseResultMap" parameterType="string">
        select id, `name`, reference, introduce, question_count, required_time
        from yh_assess_introduce where `name` = #{name}
    </select>
</mapper>
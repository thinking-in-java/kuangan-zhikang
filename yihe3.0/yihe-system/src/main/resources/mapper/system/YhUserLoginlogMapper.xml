<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhUserLoginlogMapper">
    <insert id="insertUserLoginlog" parameterType="com.yihe.system.domain.YhUserLoginlog">
        insert into yh_loginlog (`login_name`, `ipaddr`, `login_location`, `browser`, `os`, `status`, `msg`, `login_time`)
        VALUES(
               #{loginName},
               #{ipaddr},
               #{loginLocation},
               #{browser},
               #{os},
               #{status},
               #{msg},
               #{loginTime}
               )
    </insert>
</mapper>
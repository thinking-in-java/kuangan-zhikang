<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yihe.system.mapper.JiaiLocateMapper" >
  <resultMap id="BaseResultMap" type="com.yihe.system.domain.JiaiLocate" >
    <id column="lid" property="lid" jdbcType="INTEGER" />
    <result column="imei" property="imei" jdbcType="VARCHAR" />
    <result column="lat" property="lat" jdbcType="VARCHAR" />
    <result column="lon" property="lon" jdbcType="VARCHAR" />
    <result column="establishTime" property="establishTime" jdbcType="VARCHAR" />
  </resultMap>
  <select id="findNewLocate" resultMap="BaseResultMap">
    select * from jiai_locate where imei=#{imei} order by  establishTime desc limit 1
  </select>
  <insert id="insert" parameterType="com.yihe.system.domain.JiaiLocate" >
    insert into jiai_locate (imei, lat, lon
      )
    values (#{imei,jdbcType=VARCHAR}, #{lat,jdbcType=VARCHAR}, #{lon,jdbcType=VARCHAR}
      )
  </insert>
  <insert id="insertSelective" parameterType="com.yihe.system.domain.JiaiLocate" >
    insert into jiai_locate
    <trim prefix="(" suffix=")" suffixOverrides="," >
      <if test="imei != null" >
        imei,
      </if>
      <if test="lat != null" >
        lat,
      </if>
      <if test="lon != null" >
        lon,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides="," >
      <if test="imei != null" >
        #{imei,jdbcType=VARCHAR},
      </if>
      <if test="lat != null" >
        #{lat,jdbcType=VARCHAR},
      </if>
      <if test="lon != null" >
        #{lon,jdbcType=VARCHAR},
      </if>
    </trim>
  </insert>
</mapper>
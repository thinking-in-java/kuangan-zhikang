<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yihe.system.mapper.YhUserPageSettingMapper">
  <sql id="Base_Column_List">
    `code`, `name`, `explain`, `information`, `type`
  </sql>
  <select id="selectallduction" resultType="com.yihe.system.domain.YhDicIntroduction">
  	select
  	<include refid="Base_Column_List" />
  	from yh_dic_introduction
  </select>
  
  <update id="updateyhdicintroduction" parameterType="com.yihe.system.domain.YhDicIntroduction">
  	  update yh_dic_introduction
  	  <set>
  	  <if test="name!=null">
          `name` = #{name,jdbcType=VARCHAR},
      </if>
      <if test="explain!=null">
      `explain` = #{explain,jdbcType=VARCHAR},
      </if>
      <if test="information!=null">
      `information` = #{information,jdbcType=VARCHAR},
      </if>
      <if test="type!=null">
      `type` = #{type,jdbcType=INTEGER}
      </if>
      </set>
      where `code` = #{code,jdbcType=INTEGER}
  </update>

    <select id="getimg" parameterType="integer" resultType="String">
        select `explain` from yh_dic_introduction where code=#{id}
    </select>
</mapper>
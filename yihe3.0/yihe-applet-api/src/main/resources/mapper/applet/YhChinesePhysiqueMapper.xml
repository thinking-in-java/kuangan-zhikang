    <select id="getmaxplan" parameterType="String" resultMap="YhUserHealthyPlanResult">
        SELECT * FROM `yh_user_healthy_plan` WHERE user_code=#{Usercode} AND plan_state=1 AND plan_startdate &lt; (SELECT NOW())
        ORDER BY plan_day DESC LIMIT 1
    </select>

    <select id="getbeginplan" parameterType="String" resultMap="YhUserHealthyPlanResult">
        SELECT * FROM `yh_user_healthy_plan` WHERE user_code=#{Usercode} AND plan_state=0 AND plan_day =1
          LIMIT 1
    </select>

    <select id="selectplandays" resultMap="yhHealthyPlandays">
        select * from yh_healthy_plandays where planday &lt;= #{plandays} and plan_id=#{planid} ORDER BY planday DESC
    </select>

    <select id="getplandetail" parameterType="String" resultMap="yhHealthyPlandetail">

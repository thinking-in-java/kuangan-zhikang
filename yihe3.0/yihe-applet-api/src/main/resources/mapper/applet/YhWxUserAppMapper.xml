  <select id="selectRandomheandImg" resultType="string">
        select post_code
        from yh_user_reginfo as yur
                 inner join yh_instrument_record yir
                            on yir.user_code = yur.user_code
        where type = #{type}
        group by yir.user_code
        order by yir.record_id desc
        limit 5;
    </select>
  

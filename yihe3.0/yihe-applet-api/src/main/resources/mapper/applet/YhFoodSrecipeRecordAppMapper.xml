    <!--根据疾病id与userCode查询是否已存在推荐，存在则改为过期状态-->
    <update id="uptYhFoodSrecipeRecord" parameterType="com.yihe.applet.api.domain.YhFoodSrecipeRecordApp">
        UPDATE yh_food_srecipe_record SET record_type=2
        WHERE user_code=#{userCode} and record_type=1 or record_type=3
    </update>
    <!-- 查询用户是否有正在执行的健康计划 -->
    <select id="findInProgressFoodRecord"  resultMap="YhFoodSrecipeRecordResult">
    SELECT * FROM `yh_food_srecipe_record` WHERE record_mode='健康计划' AND user_code=#{usercode} AND record_type=1 limit 1
    </select>
    
    <update id="modifyType3Fortype2">
    
UPDATE 
   `yh_food_srecipe_record` 
SET
   
 `record_type` = '2',
   `standby` = NOW()  
WHERE  `record_type` = '3' AND
   
  `user_code` = #{usercode}
    
    </update>
    
      <update id="modifyType1Fortype2">
    
UPDATE 
   `yh_food_srecipe_record` 
SET
   
 `record_type` = '2',
   `standby` = NOW() 
WHERE  `record_type` = '1' AND
   
  `user_code` = #{usercode}
    
    </update>
    
    
    <!--根据疾病id与userCode查询是否已存在推荐-->
    <select id="selYhFoodSrecipeRecordCount" resultType="int" parameterType="com.yihe.applet.api.domain.YhFoodSrecipeRecordApp">
        SELECT COUNT(1) FROM yh_food_srecipe_record
        WHERE user_code=#{userCode} 
    </select>
    
    <!-- 查询用户最新评估的膳食推荐热量 -->
    <select id="findFoodSrecipeRecordByUsercodeForNow" resultMap="YhFoodSrecipeRecordResult">
    
		SELECT * FROM `yh_food_srecipe_record` WHERE user_code=#{usercode} and record_type=1 ORDER BY record_data DESC LIMIT 1

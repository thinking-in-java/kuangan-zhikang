<!DOCTYPE html>
<html  lang="zh" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>${functionName}列表</title>
    <link rel="stylesheet" th:href="@{/assets/libs/layui/css/layui.css}"/>
    <link rel="stylesheet" th:href="@{/assets/module/admin.css}"/>
</head>
<body>
<!-- 页面加载loading -->
<div class="page-loading">
    <div class="ball-loader">
        <span></span><span></span><span></span><span></span>
    </div>
</div>

<!-- 正文开始 -->
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-body">
            <div class="layui-form toolbar">
                  <div class="layui-form-item">
	                 #foreach($column in $columns)
							#if($column.query)
							#set($dictType=$column.dictType)
							#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
							#set($parentheseIndex=$column.columnComment.indexOf("（"))
							#if($parentheseIndex != -1)
							#set($comment=$column.columnComment.substring(0, $parentheseIndex))
							#else  
							#set($comment=$column.columnComment)
							#end  
							#if($column.htmlType == "input")
							
			          <div class="layui-inline">
		                <label class="layui-form-label w-auto">${comment}:</label>
		                <div class="layui-input-inline mr0">
		                    <input name="${column.javaField}" class="layui-input" type="text" placeholder="${comment}"/>
		                </div>
		              </div>
						#elseif($column.htmlType == "select" || $column.htmlType == "radio" && "" != $dictType)
					  <div class="layui-inline">
	                        <label class="layui-form-label w-auto">${comment}:</label>
	                        <div class="layui-input-inline mr0">
                               <select name="${column.javaField}">
	                                    <option value="">所有</option>
	                                    <option th:each="dict : ${type}" th:text="${dict.dictLabel}" th:value="${dict.dictValue}"></option>
	                           </select>
	                        </div>
                      </div>
							#elseif($column.htmlType == "select" || $column.htmlType == "radio" && $dictType)
		              <div class="layui-inline">
	                        <label class="layui-form-label w-auto">${comment}:</label>
	                        <div class="layui-input-inline mr0">
	                               <select name="${column.javaField}">
                                     <option value="">所有</option>
                                   </select>
	                        </div>
                      </div>
							#elseif($column.htmlType == "datetime")
					  <div class="layui-inline">
	                        <label class="layui-form-label"${comment}:</label>
	                        <div class="layui-input-inline">
	                            <input name="${column.javaField}" class="layui-input icon-date" placeholder="选择日期范围"
	                                   autocomplete="off"/>
	                        </div>
                      </div>
							#end
							#end
							#end

                    <div class="layui-inline">
                        <button class="layui-btn icon-btn" lay-filter="formSubSearchJob" lay-submit>
                            <i class="layui-icon">&#xe615;</i>查询
                        </button>
                    </div>
                    
                </div>
            </div>

            <table id="tableImport" lay-filter="tableImport"></table>
        </div>
    </div>
</div>


<!-- 表格操作列 -->
<script type="text/html" id="tableBarUser">
    <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">修改</a>
    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
</script>

<!-- 表单弹窗 -->
<script type="text/html" id="model">
    <form id="modelUserForm" lay-filter="modelForm" class="layui-form model-form">
    	#foreach($column in $columns)
				#set($dictType=$column.dictType)
				#set($javaField=$column.javaField)
				#set($parentheseIndex=$column.columnComment.indexOf("（"))
				#if($parentheseIndex != -1)
				#set($comment=$column.columnComment.substring(0, $parentheseIndex))
				#else
				#set($comment=$column.columnComment)
				#end
				#if($column.pk)
	                <input name="${javaField}" type="hidden"/>
	            #elseif($column.list && "" != $javaField)
				       <div class="layui-form-item">
				         <label class="layui-form-label layui-form-required">${comment}</label>
				            <div class="layui-input-block">
				                <input name="${javaField}" placeholder="请输入'+${comment}+'名称" type="text" class="layui-input" maxlength="20"
				                       lay-verType="tips" lay-verify="required" required/>
				            </div>   
			            </div>
	            #end
	            #end
		        <div class="layui-form-item text-right">
		            <button class="layui-btn layui-btn-primary" type="button" ew-event="closePageDialog">取消</button>
		            <button class="layui-btn" lay-filter="modelSubmit" lay-submit>保存</button>
		        </div>
    </form>
</script>



<!-- js部分 -->
<script type="text/javascript" th:src="@{/assets/libs/layui/layui.js}"></script>
<script type="text/javascript" th:src="@{/assets/js/common.js}"></script>
<script th:inline="javascript">
		#foreach($column in $columns)
		#if(${column.dictType} != '')
		        var ${column.javaField}Datas = [[${@dict.getType('${column.dictType}')}]];
		#end
		#end
       var prefix = "/${moduleName}/${businessName}";
        layui.use(['layer', 'index','form', 'table', 'util', 'admin'], function () {
	        var $ = layui.jquery;
	        var layer = layui.layer;
	        var index = layui.index;
	        var form = layui.form;
	        var table = layui.table;
	        var util = layui.util;
	        var admin = layui.admin;
	        
        // 渲染表格
        var insTb = table.render({
            elem: '#tableImport',
            url: prefix+'/list',
            request: {     
                pageName: 'pageNum' //页码的参数名称，默认：page
               ,limitName: 'pageSize' //每页数据量的参数名，默认：limit
            },
            toolbar: ['<p>',
                '<button lay-event="add" class="layui-btn layui-btn-sm icon-btn"><i class="layui-icon">&#xe621;</i>添加</button>&nbsp;',
                '<button lay-event="del" class="layui-btn layui-btn-sm layui-btn-danger icon-btn"><i class="layui-icon">&#xe640;</i>删除</button>&nbsp;',
                '</p>'].join(''),
            page: true,
            method:'post',
            cellMinWidth: 100,
            cols: [[
		        	 {
		                checkbox: true
		             },
				#foreach($column in $columns)
				#set($dictType=$column.dictType)
				#set($javaField=$column.javaField)
				#set($parentheseIndex=$column.columnComment.indexOf("（"))
				#if($parentheseIndex != -1)
				#set($comment=$column.columnComment.substring(0, $parentheseIndex))
				#else
				#set($comment=$column.columnComment)
				#end
				#if($column.pk)
	                {
	                    field: '${javaField}', 
	                    title: '${comment}',
	                    hide: false
	                },
	#elseif($column.list && "" != $dictType)
	                {
	                    field: '${javaField}', 
	                    title: '${comment}'
	                },
	#elseif($column.list && "" != $javaField)
	                {
	                    field: '${javaField}', 
	                    title: '${comment}'
	                },
	#end                
	#end
                {align: 'center', toolbar: '#tableBarUser', title: '操作', minWidth: 200}
            ]]
        });

        // 搜索
        form.on('submit(formSubSearchJob)', function (data) {
            insTb.reload({where: data.field}, 'data');
        });
        
        
        // 工具条点击事件
        table.on('tool(tableImport)', function (obj) {
            var data = obj.data;
            var layEvent = obj.event;
            if (obj.event === 'del') { 
            	// 删除
            	doDel(data);
            }else if (layEvent === 'edit') { 
            	// 修改
            	showEditModel(data);
            }
        });
        
        
        // 显示表单弹窗
        function showEditModel(mUser) {
            admin.open({
                type: 1,
                area:['500px'],
                title: (mUser ? '修改' : '添加') + ${functionName},
                content: $('#model').html(),
                success: function (layero, dIndex) {
                    $(layero).children('.layui-layer-content').css('overflow', 'visible');
                    var url = mUser ? prefix+'/edit' : prefix+'/add';
                    // 回显数据
                    form.val('modelForm', mUser);
                    // 表单提交事件
                    form.on('submit(modelSubmit)', function (data) {
                        layer.load(2);
                        $.get(url,  data.field, function (res) {
                            layer.closeAll('loading');
                            if (res.code == 200) {
                                layer.close(dIndex);
                                layer.msg(res.msg, {icon: 1});
                                insTb.reload({}, 'data');
                            } else {
                                layer.msg(res.msg, {icon: 2});
                            }
                        }, 'json');
                        return false;
                    });
                }
            });
        }
        
        
        
         /* 表格头工具栏点击事件 */
        table.on('toolbar(tableImport)', function (obj) {
            if (obj.event === 'add') { // 添加
            	showEditModel();
            }else if(obj.event === 'del'){
            	 var checkRows = table.checkStatus('tableImport');
                 if (checkRows.data.length === 0) {
                     layer.msg('请选择要删除的数据', {icon: 2});
                     return;
                 }
                 var ids = checkRows.data.map(function (d) {
                     return d.tableId;
                 });
                 doDel({tableId: ids.join(',')});
            }
        });
        
        // 删除
        function doDel(obj) {
             layer.confirm('确定要删除选中数据吗？', {
                skin: 'layui-layer-admin',
                shade: .1
            }, function (i) {
                layer.close(i);
                layer.load(2);
                $.post(prefix+'/remove', {
                	ids: obj.tableId ? obj.tableId : ''
                }, function (res) {
                    layer.closeAll('loading');
                    if (res.code == 200) {
                        layer.msg(res.msg, {icon: 1});
                        insTb.reload({}, 'data');
                    } else {
                        layer.msg(res.msg, {icon: 2});
                    }
                }, 'json');
            }); 
        }
        
        /* 渲染时间选择 */
        laydate.render({
            elem: 'input[class="icon-date"]',
            type: 'date',
            range: true,
            trigger: 'click'
        });
      
    </script>
</body>
</html>